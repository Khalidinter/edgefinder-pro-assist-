# The Odds API key from https://the-odds-api.com (host: api.the-odds-api.com/v4).
# Not theoddsapi.com — that is a different product with a different API.
ODDS_API_KEY=your_odds_api_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
# Required by paper_trade.py / rebound_paper_trade.py (they write to Supabase).
# Supabase dashboard -> Settings -> API -> service_role. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: only fetch player props for games tipping off within this many hours.
# Each event costs 1 Odds API credit per market, so this caps daily spend. 0 = no limit.
# ODDS_LOOKAHEAD_HOURS=48

# Optional: require an X-API-Secret header on scripts/api.py mutation endpoints.
# EDGEFINDER_API_SECRET=
