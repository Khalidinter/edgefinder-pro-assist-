# The Odds API key from https://the-odds-api.com (host: api.the-odds-api.com/v4).
# Not theoddsapi.com — that is a different product with a different API.
ODDS_API_KEY=your_odds_api_key

SUPABASE_URL=https://your-project.supabase.co
# Read key: the project's publishable key (sb_publishable_...). The legacy anon JWT
# keeps working only until legacy keys are disabled in Supabase -> Settings -> API Keys.
SUPABASE_KEY=sb_publishable_...
# Write key for paper_trade.py / rebound_paper_trade.py: a secret key (sb_secret_...)
# created in Supabase -> Settings -> API Keys. Replaces the legacy service_role JWT.
# Never commit the real value and never ship it in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: only fetch player props for games tipping off within this many hours.
# Each event costs 1 Odds API credit per market, so this caps daily spend. 0 = no limit.
# ODDS_LOOKAHEAD_HOURS=48

# Optional: require an X-API-Secret header on scripts/api.py mutation endpoints.
# EDGEFINDER_API_SECRET=
